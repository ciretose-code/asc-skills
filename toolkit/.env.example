# App Store Connect API key — one key (App Manager role) works for every app on
# the team, so keep this ONCE at ~/.config/asc/.env rather than per project.
# Users and Access -> Integrations -> App Store Connect API.
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_ID=XXXXXXXXXX
ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
# ASC_KEY_PATH may instead hold the .p8 contents inline as PEM.
